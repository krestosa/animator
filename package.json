{
  "name": "animator",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node server-dist/server/index.js --production",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "test:e2e": "node e2e/timeline.mjs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "postcss": "^8.5.6",
    "typescript": "^5.9.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
